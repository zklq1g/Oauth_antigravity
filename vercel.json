{
  "version": 2,
  "name": "antigravity-oauth-helper",
  "rewrites": [
    { "source": "/auth/start", "destination": "/api/start" },
    { "source": "/auth/callback", "destination": "/api/callback" },
    { "source": "/auth/exchange", "destination": "/api/exchange" },
    { "source": "/debug", "destination": "/api/debug" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
